NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional: public app URL used in client-access emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Resend (https://resend.com) for automated Client ID emails
# Free tier works. Without this key, codes still show in the UI for copy/paste.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GC Contract Manager <onboarding@resend.dev>
