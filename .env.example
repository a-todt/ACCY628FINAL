NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional: public app URL used in client-access emails and password-reset redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# In Supabase Dashboard → Authentication → URL Configuration, allow:
#   Site URL: http://localhost:3000
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     http://localhost:3000/auth/callback?next=/reset-password
#     http://localhost:3000/reset-password
#     http://localhost:3000/**

# Optional: Resend (https://resend.com) for automated Client ID emails
# Free tier works. Without this key, codes still show in the UI for copy/paste.
RESEND_API_KEY=
RESEND_FROM_EMAIL=General Contract Management <onboarding@resend.dev>
